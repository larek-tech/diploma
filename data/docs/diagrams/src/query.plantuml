@startuml Схема обработки запросов

start
:Запрос пользователя;
partition "Сервис **Crawler**" {
    partition "ollama "{
        :Преобразование запроса в вектор;
    }
    if (включен поиск по вопросам?) then
        :поиск по вопросам с выбором документов;
    else
        :поиск по векторному представлению документов;
    endif
    :Формирование запроса к pgvector;
    partition "pgvector" {
        :Выполнение запроса к pgvector;
        :Получение содержимого документов;
    }
    :Формирование ответа;
    :Получение контента из s3;
}
stop

@enduml